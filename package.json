{
	"name": "tldraw-in-obsidian",
	"version": "1.35.0",
	"description": "Create whiteboards, diagrams, and drawings with the official tldraw plugin.",
	"main": "dist/production/main.js",
	"private": true,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"clean": "rm -rf dist && rm -rf node_modules && npm install",
		"dev": "NODE_ENV=development tsx ./scripts/build.mts",
		"build": "NODE_ENV=production tsx ./scripts/build.mts",
		"vite:dev": "vite dev",
		"vite:build": "vite build",
		"version": "tsx ./scripts/version-bump.mts",
		"postinstall": "patch-package",
		"package": "tsx ./scripts/package.mts",
		"make-release-files": "tsx ./scripts/make-release-files.ts",
		"lint": "eslint src scripts",
		"lint:obsidian": "eslint -c eslint.obsidianmd.config.mjs src",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p test/tsconfig.json",
		"format-current": "prettier --write --cache $(git diff --name-only --diff-filter d | xargs)",
		"e2e": "wdio run ./wdio.conf.mts",
		"e2e:link": "npm run build && wdio run ./wdio.conf.mts --spec test/specs/link-to-obsidian.e2e.ts",
		"e2e:debug:link": "E2E_DEBUG=1 npm run e2e:link",
		"e2e:inspect:link": "E2E_PAUSE=1 npm run build && wdio run ./wdio.conf.mts --spec test/specs/link-to-obsidian.e2e.ts",
		"e2e:wdio-debug:link": "E2E_WDIO_DEBUG=1 npm run build && wdio run ./wdio.conf.mts --spec test/specs/link-to-obsidian.e2e.ts",
		"e2e:inspect:bounds-indicator": "npm run build && TEST_INTERACTIVE=true wdio run ./wdio.conf.mts --spec test/specs/bounds-tool-shape-indicator.e2e.ts",
		"test:unit": "vitest run"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"tldraw",
		"drawing",
		"whiteboard",
		"notes"
	],
	"author": "Sam Alhaqab",
	"contributors": [
		"Jonathan Mendez <dev@jon-dez.com> (https://github.com/sponsors/jon-dez)",
		"Sam Alhaqab"
	],
	"devDependencies": {
		"@eslint-react/eslint-plugin": "^5.17.3",
		"@eslint/eslintrc": "^3.3.3",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^0.14.0",
		"@obsidian-plugin-toolkit/esbuild": "^0.2.1",
		"@obsidian-plugin-toolkit/react": "^0.2.2",
		"@obsidian-plugin-toolkit/vite": "^0.3.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^24.12.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript-eslint/eslint-plugin": "^8.54.0",
		"@typescript-eslint/parser": "^8.54.0",
		"@vitejs/plugin-react": "^6.0.1",
		"@wdio/cli": "^9.26.1",
		"@wdio/globals": "^9.26.1",
		"@wdio/local-runner": "^9.26.1",
		"@wdio/mocha-framework": "^9.26.1",
		"esbuild": "^0.27.2",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-boundaries": "^7.0.2",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"expect-webdriverio": "^6.0.9",
		"jsdom": "^29.1.1",
		"mocha": "^11.7.5",
		"obsidian": "^1.11.4",
		"patch-package": "^8.0.0",
		"prettier": "^3.8.1",
		"prettier-plugin-organize-imports": "^4.3.0",
		"tslib": "2.6.3",
		"tsx": "^4.21.0",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8",
		"vitest": "^4.1.10",
		"wdio-obsidian-reporter": "^3.1.1",
		"wdio-obsidian-service": "^3.1.1",
		"webdriverio": "^9.32.0"
	},
	"dependencies": {
		"@obsidian-plugin-toolkit/e2e": "^0.1.0",
		"monkey-around": "^3.0.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tldraw": "^5.6.0",
		"zustand": "^5.0.14"
	},
	"overrides": {
		"eslint-plugin-obsidianmd": {
			"@eslint/js": "$@eslint/js",
			"obsidian": "$obsidian"
		}
	}
}
